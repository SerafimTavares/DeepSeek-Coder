import tkinter as tk
from tkinter import font
import math

class CalculadoraCientifica:
    def __init__(self, root):
        self.root = root
        self.root.title("Calculadora Científica")
        self.root.geometry("400x600")
        self.root.resizable(False, False)
        
        # Configuração de fontes
        self.fonte_display = font.Font(size=24)
        self.fonte_botoes = font.Font(size=14)
        
        # Variáveis de controle
        self.expressao = ""
        self.memoria = 0
        self.historico = []
        self.entrada_texto = tk.StringVar()
        
        # Criar interface
        self.criar_display()
        self.criar_botoes_numericos()
        self.criar_botoes_operacoes()
        self.criar_botoes_cientificos()
        self.criar_botoes_especiais()
        
    def criar_display(self):
        frame_display = tk.Frame(self.root, height=100)
        frame_display.pack(fill=tk.X, padx=10, pady=10)
        
        self.display = tk.Entry(
            frame_display,
            textvariable=self.entrada_texto,
            font=self.fonte_display,
            bd=0,
            insertwidth=1,
            width=15,
            justify="right",
            bg="#f0f0f0"
        )
        self.display.pack(fill=tk.BOTH, expand=True)
        
    def criar_botoes_numericos(self):
        frame_numeros = tk.Frame(self.root)
        frame_numeros.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)
        
        botoes_numericos = [
            '7', '8', '9',
            '4', '5', '6',
            '1', '2', '3',
            '0', '.', '(-)'
        ]
        
        for i, botao in enumerate(botoes_numericos):
            row = i // 3
            col = i % 3
            tk.Button(
                frame_numeros,
                text=botao,
                font=self.fonte_botoes,
                command=lambda x=botao: self.clicar_botao(x),
                bg="#e0e0e0",
                activebackground="#d0d0d0",
                bd=1
            ).grid(row=row, column=col, sticky="nsew", padx=2, pady=2)
            
        # Configurar expansão das células
        for i in range(4):
            frame_numeros.grid_rowconfigure(i, weight=1)
        for i in range(3):
            frame_numeros.grid_columnconfigure(i, weight=1)
    
    def criar_botoes_operacoes(self):
        frame_operacoes = tk.Frame(self.root)
        frame_operacoes.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)
        
        botoes_operacoes = [
            '/', '*', '-', '+', '='
        ]
        
        for i, botao in enumerate(botoes_operacoes):
            tk.Button(
                frame_operacoes,
                text=botao,
                font=self.fonte_botoes,
                command=lambda x=botao: self.clicar_botao(x),
                bg="#ff9800",
                fg="white",
                activebackground="#e68a00",
                bd=1
            ).grid(row=i, column=0, sticky="nsew", padx=2, pady=2)
            
        # Configurar expansão
        for i in range(5):
            frame_operacoes.grid_rowconfigure(i, weight=1)
        frame_operacoes.grid_columnconfigure(0, weight=1)
    
    def criar_botoes_cientificos(self):
        frame_cientifico = tk.Frame(self.root)
        frame_cientifico.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)
        
        botoes_cientificos = [
            'sin', 'cos', 'tan',
            'log', 'ln', '√',
            'x²', 'x³', 'x^y',
            'π', 'e', 'n!'
        ]
        
        for i, botao in enumerate(botoes_cientificos):
            row = i // 3
            col = i % 3
            tk.Button(
                frame_cientifico,
                text=botao,
                font=self.fonte_botoes,
                command=lambda x=botao: self.clicar_botao(x),
                bg="#9e9e9e",
                fg="white",
                activebackground="#7e7e7e",
                bd=1
            ).grid(row=row, column=col, sticky="nsew", padx=2, pady=2)
            
        # Configurar expansão
        for i in range(4):
            frame_cientifico.grid_rowconfigure(i, weight=1)
        for i in range(3):
            frame_cientifico.grid_columnconfigure(i, weight=1)
    
    def criar_botoes_especiais(self):
        frame_especial = tk.Frame(self.root)
        frame_especial.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)
        
        botoes_especiais = [
            'C', 'CE', '⌫', 'M+', 'MR', 'MC'
        ]
        
        for i, botao in enumerate(botoes_especiais):
            tk.Button(
                frame_especial,
                text=botao,
                font=self.fonte_botoes,
                command=lambda x=botao: self.clicar_botao(x),
                bg="#607d8b",
                fg="white",
                activebackground="#455a64",
                bd=1
            ).grid(row=0, column=i, sticky="nsew", padx=2, pady=2)
            
        # Configurar expansão
        for i in range(6):
            frame_especial.grid_columnconfigure(i, weight=1)
    
    def clicar_botao(self, valor):
        try:
            if valor == '=':
                resultado = str(eval(self.expressao))
                self.historico.append(f"{self.expressao} = {resultado}")
                self.entrada_texto.set(resultado)
                self.expressao = resultado
            elif valor == 'C':
                self.expressao = ""
                self.entrada_texto.set("")
            elif valor == 'CE':
                self.expressao = ""
                self.entrada_texto.set("")
                self.historico = []
            elif valor == '⌫':
                self.expressao = self.expressao[:-1]
                self.entrada_texto.set(self.expressao)
            elif valor == '(-)':
                if self.expressao and self.expressao[-1].isdigit():
                    self.expressao = f"-{self.expressao}"
                    self.entrada_texto.set(self.expressao)
            elif valor == 'M+':
                self.memoria = float(self.entrada_texto.get())
            elif valor == 'MR':
                self.expressao += str(self.memoria)
                self.entrada_texto.set(self.expressao)
            elif valor == 'MC':
                self.memoria = 0
            elif valor == 'π':
                self.expressao += str(math.pi)
                self.entrada_texto.set(self.expressao)
            elif valor == 'e':
                self.expressao += str(math.e)
                self.entrada_texto.set(self.expressao)
            elif valor == 'sin':
                num = float(self.entrada_texto.get())
                resultado = math.sin(math.radians(num))
                self.entrada_texto.set(str(resultado))
                self.expressao = str(resultado)
            elif valor == 'cos':
                num = float(self.entrada_texto.get())
                resultado = math.cos(math.radians(num))
                self.entrada_texto.set(str(resultado))
                self.expressao = str(resultado)
            elif valor == 'tan':
                num = float(self.entrada_texto.get())
                resultado = math.tan(math.radians(num))
                self.entrada_texto.set(str(resultado))
                self.expressao = str(resultado)
            elif valor == 'log':
                num = float(self.entrada_texto.get())
                resultado = math.log10(num)
                self.entrada_texto.set(str(resultado))
                self.expressao = str(resultado)
            elif valor == 'ln':
                num = float(self.entrada_texto.get())
                resultado = math.log(num)
                self.entrada_texto.set(str(resultado))
                self.expressao = str(resultado)
            elif valor == '√':
                num = float(self.entrada_texto.get())
                resultado = math.sqrt(num)
                self.entrada_texto.set(str(resultado))
                self.expressao = str(resultado)
            elif valor == 'x²':
                num = float(self.entrada_texto.get())
                resultado = num ** 2
                self.entrada_texto.set(str(resultado))
                self.expressao = str(resultado)
            elif valor == 'x³':
                num = float(self.entrada_texto.get())
                resultado = num ** 3
                self.entrada_texto.set(str(resultado))
                self.expressao = str(resultado)
            elif valor == 'x^y':
                self.expressao += '**'
                self.entrada_texto.set(self.expressao)
            elif valor == 'n!':
                num = int(float(self.entrada_texto.get()))
                resultado = math.factorial(num)
                self.entrada_texto.set(str(resultado))
                self.expressao = str(resultado)
            else:
                self.expressao += str(valor)
                self.entrada_texto.set(self.expressao)
        except Exception as e:
            self.entrada_texto.set("Erro")
            self.expressao = ""

if __name__ == "__main__":
    root = tk.Tk()
    calculadora = CalculadoraCientifica(root)
    root.mainloop()